# ─────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno para SlideForge
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas el archivo .env a git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────

# ─── SUPABASE ────────────────────────────────────────────────────────
# Obtén estos valores en:
# https://supabase.com/dashboard/project/<tu-proyecto>/settings/api

# URL del proyecto (usada en servidor y cliente)
SUPABASE_URL="https://<tu-proyecto>.supabase.co"
SUPABASE_PROJECT_ID="<tu-project-id>"

# Clave anónima (anon key) — segura para el navegador
SUPABASE_PUBLISHABLE_KEY="eyJ..."

# Variables con prefijo VITE_ son accesibles desde el navegador (Vite)
VITE_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."

# Service Role Key — SOLO servidor. NUNCA uses el prefijo VITE_ aquí.
# Empieza con eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── GOOGLE GEMINI ───────────────────────────────────────────────────
# Obtén tu API key gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# Modelo de Gemini a usar (opcional — por defecto usa gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# ─── DEEPSEEK ────────────────────────────────────────────────────────
# Motor principal para análisis de documentos y estructuración de slides.
# Obtén tu API key en: https://platform.deepseek.com/api_keys
# Si no se configura, se usará Gemini para todo.
DEEPSEEK_API_KEY="sk-..."

# ─── ANALYTICS (opcional) ────────────────────────────────────────────
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"
